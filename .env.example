# ==============================================================================
# TikTok Downloader - Environment Variables Configuration
# ==============================================================================

# Canonical Base URL (used for SEO metadata, Open Graph, Sitemap, Robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site Branding & Contact
NEXT_PUBLIC_SITE_NAME="TikTok Downloader"
SITE_CONTACT_EMAIL="support@yourdomain.com"

# Provider Selection (options: rapidapi, custom)
VIDEO_PROVIDER=rapidapi

# RapidAPI Configuration (obtain from RapidAPI TikTok scraper/downloader providers,
# such as 'tiktok-downloader-download-tiktok-videos-without-watermark' or 'tiktok-all-in-one')
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=tiktok-downloader-download-tiktok-videos-without-watermark.p.rapidapi.com
RAPIDAPI_ENDPOINT=https://tiktok-downloader-download-tiktok-videos-without-watermark.p.rapidapi.com/index

# Rate Limiting Configuration (in-memory sliding window or redis)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Optional: Upstash / Redis Configuration for Distributed Production Rate Limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Google AdSense Publisher ID (Leave blank or unconfigured until approved)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
